{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "codegenie-be/laravel-livewire-multistep-form",
    "type": "library",
    "description": "A lightweight, configurable multi-step form wizard for Laravel Livewire.",
    "keywords": [
        "form-wizard",
        "laravel",
        "livewire",
        "multi-step-form"
    ],
    "homepage": "https://github.com/Codegenie-BE/laravel-livewire-multistep-form",
    "license": "MIT",
    "authors": [
        {
            "name": "Codegenie",
            "homepage": "https://www.codegenie.be"
        }
    ],
    "support": {
        "issues": "https://github.com/Codegenie-BE/laravel-livewire-multistep-form/issues",
        "source": "https://github.com/Codegenie-BE/laravel-livewire-multistep-form"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "livewire/livewire": "^3.6 || ^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Codegenie\\LivewireMultistepForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint --test src tests",
        "analyse": "phpstan analyse --memory-limit=1G",
        "audit": "composer audit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codegenie\\LivewireMultistepForm\\LivewireMultistepFormServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
